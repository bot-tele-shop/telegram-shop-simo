SHOP_ENVIRONMENT=development
SHOP_DATABASE_URL=postgresql+asyncpg://telegram_shop:telegram_shop@localhost:5432/telegram_shop
SHOP_LOG_LEVEL=INFO
SHOP_SUPABASE_AUTH_ISSUER=https://your-project-ref.supabase.co/auth/v1
SHOP_ADMIN_JWT_AUDIENCE=authenticated
# Required in production; generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
SHOP_INVENTORY_ENCRYPTION_KEY=
SHOP_INVENTORY_KEY_VERSION=v1
# Required in production; use independent random values of at least 32 characters.
SHOP_WEBHOOK_PATH_SECRET=
SHOP_WEBHOOK_HEADER_SECRET=
