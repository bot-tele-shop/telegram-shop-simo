# Copy/export these values yourself; this project deliberately does not load .env files.
# Matches compose.yaml, which binds PostgreSQL only to localhost.
DATABASE_URL=postgresql+psycopg://velmora:change-me-local-only@127.0.0.1:54329/velmora_dev
DATABASE_SCHEMA=demo_velmora_example
FERNET_KEY=replace-with-a-generated-Fernet-key
VELMORA_MODE=simulation
# TEST_DATABASE_URL is intentionally separate and must name a disposable PostgreSQL test database.
TEST_DATABASE_URL=postgresql+psycopg://velmora:change-me-local-only@127.0.0.1:54329/velmora_test
# Optional demo ledger path. It must not already exist; omit to use a fresh temporary workspace.
# SIMULATED_LEDGER=/absolute/path/to/new-demo-ledger.sqlite
